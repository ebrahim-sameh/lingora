# ------------------------------------------------------------------------------
# Lingora — environment variables
# ------------------------------------------------------------------------------
# Copy this file to `apps/web/.env.local` for the Next.js app and to an env file
# (or secrets manager) for the worker deployment. Do not commit real values.
# ------------------------------------------------------------------------------

# App — public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1) Clerk — https://dashboard.clerk.com
#    Create a new application, then copy the publishable + secret keys.
#    Set the Clerk webhook endpoint to:  {NEXT_PUBLIC_APP_URL}/api/clerk/webhook
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------------------------
# 2) Neon Postgres — https://console.neon.tech
#    Create a project, copy the pooled connection string.
#    Run: `pnpm db:push` after the first deploy to apply the Drizzle schema.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/lingora?sslmode=require

# ------------------------------------------------------------------------------
# 3) Stripe — https://dashboard.stripe.com/test/apikeys
#    Use TEST mode. Run: `pnpm stripe:setup` to create products, prices, and the
#    billing meter. The script prints the STRIPE_PRICE_* env vars to paste here.
#    Set the webhook endpoint to: {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
#    with events: checkout.session.completed, customer.subscription.*,
#    invoice.payment_failed.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_METER_ID=mtr_xxx
STRIPE_METER_EVENT_NAME=speaking_minutes

# ------------------------------------------------------------------------------
# 4) LiveKit Cloud — https://cloud.livekit.io
#    Create a project, copy API key + secret + wss:// URL.
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://lingora-xxx.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://lingora-xxx.livekit.cloud
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=xxx

# ------------------------------------------------------------------------------
# 5) Gladia — https://app.gladia.io
#    Solaria-1 streaming speech-to-text.
# ------------------------------------------------------------------------------
GLADIA_API_KEY=xxx

# ------------------------------------------------------------------------------
# 6) Google Gemini — https://aistudio.google.com/app/apikey
#    Gemini 2.5 Flash is used for live translation.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIxxx
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 7) Cartesia — https://play.cartesia.ai/api-keys
#    Sonic-3 streaming text-to-speech.
# ------------------------------------------------------------------------------
CARTESIA_API_KEY=xxx

# ------------------------------------------------------------------------------
# Worker — shared secret with /api/usage webhook on the web app.
# Only the worker deployment needs these (plus 4,5,6,7 above).
# ------------------------------------------------------------------------------
WORKER_USAGE_WEBHOOK_URL=https://your-lingora.vercel.app/api/usage
WORKER_USAGE_SECRET=generate-a-long-random-string-here
